{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "paths": {}
  },
  "include": ["types/**/*.d.ts", "typecheck.ts"],
  "exclude": ["node_modules", "src", "tests"]
}
